<!DOCTYPE html>
<html>
<head>
    <title>Graph Generator</title>
</head>
<body>
<h1>Generare de arbori partiali cu ponderi in ordine crescatoare</h1>
<form action="bonus-servlet" method="get">

    <label for="order">Ordinul grafului:</label>
    <input type="text" id="order" name="order"><br><br>

    <label for="k">Numarul de arbori partiali:</label>
